# --- Application ---
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (PostgreSQL 15+; Docker or Supabase) ---
DATABASE_URL=postgresql+asyncpg://nasiya:nasiya@localhost:5432/nasiya_pro
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
# Supabase pooler (PgBouncer, transaction mode) uchun true qiling
DB_USE_PGBOUNCER=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_INIT_DATA_TTL_SECONDS=86400

# --- Payment OTP ---
# Kamida 32 belgili tasodifiy qiymat:  python -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_SECRET=replace-with-a-long-random-secret-value-min-32-chars
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_REQUIRED_FOR_AGENT_PAYMENTS=true
