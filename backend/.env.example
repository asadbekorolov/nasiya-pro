# --- Application ---
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (PostgreSQL 15+; Docker or Supabase) ---
DATABASE_URL=postgresql+asyncpg://nasiya:nasiya@localhost:5432/nasiya_pro
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
# Supabase: Dashboard -> Connect -> "Session pooler" (port 5432), driver +asyncpg, TLS:
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
#   DB_POOL_SIZE=5 / DB_MAX_OVERFLOW=5 (free plan pooler allows ~15 connections)
# Migration 0004 enables RLS and revokes anon/authenticated access, so the Supabase
# Data API cannot read the ledger. Never commit the real URL (it contains the password).
# Transaction pooler (port 6543 / PgBouncer) uchun true qiling:
DB_USE_PGBOUNCER=false

# --- Telegram ---
# BotFather token. NEVER commit a real token: keep it only in .env (git-ignored).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
TELEGRAM_BOT_USERNAME=nasiya_pro_bot
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
# Public HTTPS URL of the Mini App (frontend). Without https the bot shows no app buttons.
WEBAPP_URL=https://app.example.uz
# off | polling (dev, single process) | webhook (production)
BOT_MODE=polling
# Webhook mode only:
BOT_WEBHOOK_BASE_URL=
BOT_WEBHOOK_SECRET=

# --- Payment OTP ---
# Kamida 32 belgili tasodifiy qiymat:  python -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_SECRET=replace-with-a-long-random-secret-value-min-32-chars
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_REQUIRED_FOR_AGENT_PAYMENTS=true
# telegram = send via bot (required in staging/production); log = print to server log (local dev)
OTP_DELIVERY=telegram

# --- Local runner (run_live.py) ---
# Telegram user id of the platform founder: becomes the Wholesaler Admin of the demo
# tenant. Personal data — set it here (or via --owner-id), never commit it.
FOUNDER_TELEGRAM_ID=
FOUNDER_NAME=
