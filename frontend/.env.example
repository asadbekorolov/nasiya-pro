# Absolute API origin when the Mini App is NOT served behind the same domain as the API.
# Leave empty to use relative /api/v1 (recommended: one domain, reverse proxy).
VITE_API_BASE_URL=

# --- Development only (ignored in production builds) ---
# Signed initData for testing outside Telegram. Generate with:
#   cd ../backend && uv run python scripts/dev_init_data.py --tg-id <telegram_user_id>
VITE_DEV_INIT_DATA=
# Optional tenant selector for users registered at several wholesalers.
VITE_DEV_WHOLESALER_ID=
# Where `npm run dev` proxies /api (FastAPI).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
