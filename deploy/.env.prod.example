# Nasiya Pro — production settings for docker-compose.prod.yml.
#
#   cp deploy/.env.prod.example deploy/.env.prod     (deploy/.env.prod is git-ignored)
#
# Used twice: by `docker compose --env-file` (variables inside the compose file) and
# as the backend container's env_file. Never commit the filled-in copy.

# --- Domain & TLS --------------------------------------------------------------------------
# DNS A record of this domain must point at the server before the first start.
DOMAIN=app.example.uz
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=admin@example.uz

# --- PostgreSQL ----------------------------------------------------------------------------
POSTGRES_DB=nasiya_pro
POSTGRES_USER=nasiya
# Letters and digits only (it is embedded in DATABASE_URL). Generate:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# --- Telegram bot --------------------------------------------------------------------------
# From @BotFather. Keep it only here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=nasiya_pro_bot
# webhook (recommended): Telegram POSTs updates to https://DOMAIN/api/v1/telegram/webhook
# polling: only with WEB_CONCURRENCY=1
BOT_MODE=webhook
# Random secret Telegram sends back in X-Telegram-Bot-Api-Secret-Token
# (32-256 chars of A-Z a-z 0-9 _ -). Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_WEBHOOK_SECRET=

# --- Payment OTP & signed download links -----------------------------------------------------
# At least 32 random characters. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_SECRET=
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_REQUIRED_FOR_AGENT_PAYMENTS=true
OTP_DELIVERY=telegram

# --- Runtime -------------------------------------------------------------------------------
# uvicorn worker processes (webhook mode). Rule of thumb: 2 x CPU cores, max ~8.
WEB_CONCURRENCY=2
DEBUG=false
